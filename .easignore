# .easignore replaces .gitignore for EAS builds — must include everything from .gitignore

# === Dependencies ===
node_modules/

# === Expo/Native (EAS generates these via prebuild) ===
.expo/
dist/
web-build/
expo-env.d.ts
/ios
/android
/packages/happy-app/ios
/packages/happy-app/android

# === Native build artifacts ===
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# === Metro ===
.metro-health-check*

# === Debug logs ===
npm-debug.*
yarn-debug.*
yarn-error.*

# === OS / editor ===
.DS_Store
*.pem

# === Env files (secrets) ===
.env*.local
.env

# === TypeScript build info ===
*.tsbuildinfo

# === Python ===
__pycache__/
*.pyc

# === Dev tooling (not needed for app build) ===
.claude/
.serena/
.mypy_cache/
.pytest_cache/
.plan
CLAUDE.local.md
progress*.txt

# === Non-workspace packages ===
packages/happy-voice-agent/

# === Workspace packages (custom build creates stubs before install) ===
packages/happy-cli/
packages/happy-server/
packages/happy-agent/

# === Heavy directories ===
.git/
docs/
notes/
.github/

# === Root artifacts ===
*.ipa
*.cer
yarn.lock
logo.png

# === Dev config ===
mise.toml
packages/happy-app/mise.toml
.dev/
.worktrees/

# === App-specific exclusions ===
packages/happy-app/src-tauri/
packages/happy-app/**/*.test.ts
packages/happy-app/**/*.test.tsx
packages/happy-app/**/*.spec.ts
packages/happy-app/**/*.spec.tsx
packages/happy-app/sources/sync/__testdata__/
