{
  "cli": {
    "version": ">= 14.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "autoIncrement": true,
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "bun": "1.3.10",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "bun": "1.3.10",
      "config": "ios-preview.yml",
      "env": {
        "APP_ENV": "preview",
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "preview",
      "bun": "1.3.10",
      "env": {
        "APP_ENV": "preview"
      }
    }
  }
}
